{% extends "../base.njk" %}
{% block title %}Iniciar sesión - FotoBlog{% endblock %}
{% block body %}
<div class="auth-page">
  <div class="auth-card">
    <h2><i class="fa fa-sign-in text-primary"></i> Iniciar sesión</h2>
    <p class="auth-subtitle">Accede a tu cuenta para gestionar tu perfil y contenido</p>

    {% if currentUser %}
      <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> Has iniciado sesión como <strong>{{ currentUser.email }}</strong>. <a href="/logout">Cerrar sesión</a>
      </div>
    {% else %}
      <form method="post" action="/login">
        <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">

        <div class="form-group">
          <label for="inputEmail"><i class="fa fa-envelope"></i> Email o nombre</label>
          <input type="text" value="{{ lastUsername }}" name="_username" id="inputEmail" class="form-control" placeholder="Tu email o nombre" autocomplete="username" required autofocus>
        </div>

        <div class="form-group">
          <label for="inputPassword"><i class="fa fa-lock"></i> Contraseña</label>
          <input type="password" name="_password" id="inputPassword" class="form-control" placeholder="Tu contraseña" autocomplete="current-password" required>
        </div>

        <div style="text-align: right; margin-bottom: 15px;">
          <a href="/forgot-password" style="color: var(--primary); font-size: 14px; text-decoration: none;">¿Olvidaste tu contraseña?</a>
        </div>

        <button class="btn-auth" type="submit">
          <i class="fa fa-sign-in"></i> Iniciar sesión
        </button>
      </form>
    {% endif %}

    <div class="auth-footer">
      ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
    </div>
  </div>
</div>
{% endblock %}
