{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block body %}
<div id="register">
  <div class="container">
    <h1>Register</h1>

    <form action="/register" method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" class="form-control" value="{{ values.email or '' }}">
        {{ forms.error(errors, 'email') }}
      </div>

      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" class="form-control" value="{{ values.name or '' }}">
        {{ forms.error(errors, 'name') }}
      </div>

      <div class="form-group">
        <label for="plainPassword">Password</label>
        <input type="password" id="plainPassword" name="plainPassword" class="form-control" autocomplete="new-password">
        {{ forms.error(errors, 'plainPassword') }}
      </div>

      <div class="checkbox">
        <label>
          <input type="checkbox" name="agreeTerms" value="1"> I agree to the terms and conditions
        </label>
        {{ forms.error(errors, 'agreeTerms') }}
      </div>

      <button type="submit" class="pull-right btn btn-lg sr-button">Register</button>
    </form>
  </div>
</div>
{% endblock %}
