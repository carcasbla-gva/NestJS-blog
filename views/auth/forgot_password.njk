{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Recuperar contraseña | PhotographItem{% endblock %}
{% block body %}
<div id="register">
  <div class="container">
    <div class="col-xs-12 col-sm-6 col-sm-push-3">
      <h1>Recuperar contraseña</h1>
      <p class="text-muted">Introduce tu email y te enviaremos un enlace para crear una contraseña nueva.</p>
      <hr class="divider">

      <form action="/forgot-password" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" value="{{ values.email or '' }}" autocomplete="email" required>
          {{ forms.error(errors, 'email') }}
        </div>

        <button type="submit" class="btn btn-lg sr-button">Enviar enlace</button>
        <a href="/login" class="btn btn-link">Volver al login</a>
      </form>
    </div>
  </div>
</div>
{% endblock %}
