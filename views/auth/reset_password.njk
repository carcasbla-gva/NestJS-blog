{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Nueva contraseña | PhotographItem{% endblock %}
{% block body %}
<div id="register">
  <div class="container">
    <div class="col-xs-12 col-sm-6 col-sm-push-3">
      <h1>Nueva contraseña</h1>
      <p class="text-muted">Elige una contraseña de al menos 6 caracteres.</p>
      <hr class="divider">

      <form action="/reset-password/{{ token }}" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" class="form-control" autocomplete="new-password" required>
          {{ forms.error(errors, 'password') }}
        </div>

        <div class="form-group">
          <label for="confirmation">Repite la contraseña</label>
          <input type="password" id="confirmation" name="confirmation" class="form-control" autocomplete="new-password" required>
          {{ forms.error(errors, 'confirmation') }}
        </div>

        <button type="submit" class="btn btn-lg sr-button">Guardar contraseña</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
