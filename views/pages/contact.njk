{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Contacto - FotoBlog{% endblock %}
{% block body %}
<div id="contact">
  <div class="container">
    <!-- Header -->
    <div class="contact-header">
      <h1><i class="fa fa-envelope"></i> Contacto</h1>
      <p>¿Tienes alguna pregunta o quieres trabajar con nosotros? No dudes en escribirnos.</p>
    </div>

    <!-- Contact Form -->
    <div class="contact-form-card">
      <form action="/contact" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="row">
          <div class="col-sm-6">
            <div class="form-group">
              <label for="firstName"><i class="fa fa-user"></i> Nombre</label>
              <input type="text" id="firstName" name="firstName" class="form-control" placeholder="Tu nombre" value="{{ values.firstName or '' }}">
              {{ forms.error(errors, 'firstName') }}
            </div>
          </div>
          <div class="col-sm-6">
            <div class="form-group">
              <label for="lastName"><i class="fa fa-user"></i> Apellidos</label>
              <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Tus apellidos" value="{{ values.lastName or '' }}">
              {{ forms.error(errors, 'lastName') }}
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="email"><i class="fa fa-envelope"></i> Email</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="tu@email.com" value="{{ values.email or '' }}">
          {{ forms.error(errors, 'email') }}
        </div>

        <div class="form-group">
          <label for="subject"><i class="fa fa-tag"></i> Asunto</label>
          <input type="text" id="subject" name="subject" class="form-control" placeholder="¿En qué podemos ayudarte?" value="{{ values.subject or '' }}">
          {{ forms.error(errors, 'subject') }}
        </div>

        <div class="form-group">
          <label for="message"><i class="fa fa-comment"></i> Mensaje</label>
          <textarea id="message" name="message" class="form-control" rows="5" placeholder="Escribe tu mensaje aquí...">{{ values.message or '' }}</textarea>
          {{ forms.error(errors, 'message') }}
        </div>

        <button type="submit" class="btn-primary" style="width: 100%;">
          <i class="fa fa-paper-plane"></i> Enviar mensaje
        </button>
      </form>
    </div>

    <!-- Contact Info Cards -->
    <div class="contact-info-cards">
      <div class="contact-info-card">
        <i class="fa fa-phone"></i>
        <h5>Teléfono</h5>
        <p>(00228) 92229954</p>
      </div>
      <div class="contact-info-card">
        <i class="fa fa-envelope"></i>
        <h5>Email</h5>
        <p>info@fotoblog.com</p>
      </div>
      <div class="contact-info-card">
        <i class="fa fa-map-marker"></i>
        <h5>Dirección</h5>
        <p>35 North Drive, Adroukpape</p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
