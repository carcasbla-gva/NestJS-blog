{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block body %}
<!-- Principal Content Start -->
<div id="contact">
  <div class="container">
    <div class="col-xs-12 col-sm-8 col-sm-push-2">
      <h1>CONTACT US</h1>
      <hr>
      <p>Aut eaque, laboriosam veritatis, quos non quis ad perspiciatis, totam corporis ea, alias ut unde.</p>

      <form class="form-horizontal" action="/contact" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <div class="col-xs-6">
            <label for="firstName">First Name</label>
            <input type="text" id="firstName" name="firstName" class="form-control" value="{{ values.firstName or '' }}">
            {{ forms.error(errors, 'firstName') }}
          </div>
          <div class="col-xs-6">
            <label for="lastName">Last Name</label>
            <input type="text" id="lastName" name="lastName" class="form-control" value="{{ values.lastName or '' }}">
            {{ forms.error(errors, 'lastName') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ values.email or '' }}">
            {{ forms.error(errors, 'email') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" class="form-control" value="{{ values.subject or '' }}">
            {{ forms.error(errors, 'subject') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="message">Message</label>
            <textarea id="message" name="message" class="form-control" rows="5">{{ values.message or '' }}</textarea>
            {{ forms.error(errors, 'message') }}
            <button type="submit" class="pull-right btn btn-lg sr-button">Send</button>
          </div>
        </div>
      </form>

      <hr class="divider">
      <div class="address">
        <h3>GET IN TOUCH</h3>
        <hr>
        <p>Sunt ut voluptatum eius sapiente, totam reiciendis temporibus qui quibusdam, recusandae sit vero.</p>
        <div class="ending text-center">
          <ul class="list-inline social-buttons">
            <li><a href="#"><i class="fa fa-facebook sr-icons"></i></a></li>
            <li><a href="#"><i class="fa fa-twitter sr-icons"></i></a></li>
            <li><a href="#"><i class="fa fa-google-plus sr-icons"></i></a></li>
          </ul>
          <ul class="list-inline contact">
            <li class="footer-number"><i class="fa fa-phone sr-icons"></i> (00228)92229954 </li>
            <li><i class="fa fa-envelope sr-icons"></i> kouvenceslas93@gmail.com</li>
          </ul>
          <p>Photography Fanatic Template &copy; 2017</p>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Principal Content Start -->
{% endblock %}
