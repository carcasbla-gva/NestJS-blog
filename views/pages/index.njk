{% extends "../base.njk" %}
{% block body %}
<div id="index">

  <!-- Header -->
  <div class="row">
    <div class="col-xs-12 intro">
      <div class="carousel-inner">
        <div class="item active">
          <img class="img-responsive" src="{{ asset('images/index/woman.jpg') }}" alt="header picture">
        </div>
        <div class="carousel-caption">
          <h1>FIND NICE PICTURES HERE</h1>
          <hr>
        </div>
      </div>
    </div>
  </div>

  <div id="index-body">
    <!-- Pictures Navigation table -->
    <div class="table-responsive">
      <table class="table text-center">
        <thead>
          <tr>
            {% for category in categories %}
              <td>
                <a class="link {% if loop.first %}active{% endif %}" href="#category{{ category.id }}" data-toggle="tab">
                  {{ category.name }}
                </a>
              </td>
            {% endfor %}
          </tr>
        </thead>
      </table>
      <hr>
    </div>

    <!-- Navigation Table Content -->
    <div class="tab-content">
      {% for category in categories %}
        <div id="category{{ category.id }}" class="tab-pane {% if loop.first %}active{% endif %}">
          <div class="row popup-gallery">
            {% for image in category.images %}
              {% include "../partials/image.njk" %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    <!-- End of Navigation Table Content -->
  </div><!-- End of Index-body box -->

  <!-- Newsletter form -->
  <div class="index-form text-center">
    <h3>SUSCRIBE TO OUR NEWSLETTER</h3>
    <h5>Suscribe to receive our News and Gifts</h5>
    <form class="form-horizontal">
      <div class="form-group">
        <div class="col-xs-12 col-sm-6 col-sm-push-3 col-md-4 col-md-push-4">
          <input class="form-control" type="text" placeholder="Type here your email address">
          <a href="" class="btn btn-lg sr-button">SUBSCRIBE</a>
        </div>
      </div>
    </form>
  </div>
  <!-- End of Newsletter form -->

  <!-- Box within partners name and logo -->
  <div class="last-box row">
    <div class="col-xs-12 col-sm-4 col-sm-push-4 last-block">
      <div class="partner-box text-center">
        <p>
          <i class="fa fa-map-marker fa-2x sr-icons"></i>
          <span class="text-muted">35 North Drive, Adroukpape, PY 88105, Agoe Telessou</span>
        </p>
        <h4>Our Main Partners</h4>
        <hr>
        <div class="text-muted text-left">
          <ul class="list-inline">
            <li><img src="{{ asset('images/index/log2.jpg') }}" alt="logo"></li>
            <li>First Partner Name</li>
          </ul>
          <ul class="list-inline">
            <li><img src="{{ asset('images/index/log1.jpg') }}" alt="logo"></li>
            <li>Second Partner Name</li>
          </ul>
          <ul class="list-inline">
            <li><img src="{{ asset('images/index/log3.jpg') }}" alt="logo"></li>
            <li>Third Partner Name</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <!-- End of Box within partners name and logo -->

</div><!-- End of index box -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function postJson(url) {
      return fetch(url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).then(function (response) { return response.json(); });
    }

    document.querySelectorAll('.js-image-view').forEach(function (link) {
      link.addEventListener('click', function () {
        var id = link.getAttribute('data-id');
        postJson('/images/' + id + '/view').then(function (data) {
          var counter = document.querySelector('.js-views-' + id);
          if (data.success && counter) {
            counter.textContent = data.views;
          }
        }).catch(function () {});
      });
    });

    document.querySelectorAll('.js-image-like').forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        var id = link.getAttribute('data-id');
        postJson('/images/' + id + '/like').then(function (data) {
          var counter = document.querySelector('.js-likes-' + id);
          if (data.success && counter) {
            counter.textContent = data.likes;
            link.style.opacity = data.liked ? '1' : '0.6';
          }
        }).catch(function () {});
      });
    });

    document.querySelectorAll('.js-image-download').forEach(function (link) {
      link.addEventListener('click', function () {
        var id = link.getAttribute('data-id');
        var counter = document.querySelector('.js-downloads-' + id);
        if (counter) {
          counter.textContent = Number(counter.textContent) + 1;
        }
      });
    });
  });
</script>
{% endblock %}
