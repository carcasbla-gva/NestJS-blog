{% extends "../base.njk" %}
{% block title %}FotoBlog - Galería de Fotografía{% endblock %}
{% block body %}
<div id="index">

  <!-- Hero Carousel -->
  <div class="hero-carousel carousel slide" id="heroCarousel" data-ride="carousel" data-interval="5000">

    <!-- Indicators -->
    <ol class="carousel-indicators">
      {% for slide in carouselImages %}
        <li data-target="#heroCarousel" data-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active"{% endif %}></li>
      {% endfor %}
    </ol>

    <!-- Wrapper for slides -->
    <div class="carousel-inner" role="listbox">
      {% for slide in carouselImages %}
        <div class="item{% if loop.first %} active{% endif %}" style="background-image: url('{{ asset('images/gallery/' ~ slide.image.file) }}')">
          <div class="carousel-caption">
            <h1>{{ slide.category.name }}</h1>
            <p>{{ slide.category.description or 'Descubre nuestra colección de fotografía profesional' }}</p>
            <a href="/blog" class="btn-hero">Explorar Blog <i class="fa fa-arrow-right"></i></a>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Controls -->
    <a class="left carousel-control" href="#heroCarousel" role="button" data-slide="prev">
      <i class="fa fa-chevron-left" aria-hidden="true"></i>
      <span class="sr-only">Anterior</span>
    </a>
    <a class="right carousel-control" href="#heroCarousel" role="button" data-slide="next">
      <i class="fa fa-chevron-right" aria-hidden="true"></i>
      <span class="sr-only">Siguiente</span>
    </a>
  </div>

  <!-- Category Tabs & Gallery -->
  <div class="container">
    <div class="category-tabs animate-on-scroll">
      <!-- Category Navigation -->
      <ul class="nav nav-tabs" role="tablist">
        {% for category in categories %}
          <li role="presentation"{% if loop.first %} class="active"{% endif %}>
            <a href="#category{{ category.id }}" aria-controls="category{{ category.id }}" role="tab" data-toggle="tab">
              {{ category.name }}
            </a>
          </li>
        {% endfor %}
      </ul>

      <!-- Gallery Content -->
      <div class="tab-content">
        {% for category in categories %}
          <div role="tabpanel" class="tab-pane{% if loop.first %} active{% endif %}" id="category{{ category.id }}">
            <div class="gallery-grid">
              {% for image in category.images %}
                <div class="gallery-item animate-on-scroll animate-scale" style="transition-delay: {{ loop.index0 * 0.05 }}s;">
                  <a href="{{ asset('images/gallery/' ~ image.file) }}" class="image-popup">
                    <img src="{{ asset('images/portfolio/' ~ image.file) }}" alt="{{ image.file }}" loading="lazy">
                  </a>
                  <div class="gallery-overlay">
                    <a href="{{ asset('images/gallery/' ~ image.file) }}" class="image-popup" style="color: white; text-decoration: none;">
                      <i class="fa fa-search-plus"></i> Ver imagen
                    </a>
                  </div>
                  <div class="gallery-info">
                    <h5>{{ image.file | replace({'.jpg': '', '.jpeg': '', '.png': '', '.webp': ''}) | title }}</h5>
                    <div class="gallery-stats">
                      <span class="views"><i class="fa fa-eye"></i> <span class="js-views-{{ image.id }}">{{ image.numViews }}</span></span>
                      <span class="likes"><i class="fa fa-heart"></i> <span class="js-likes-{{ image.id }}">{{ image.numLikes }}</span></span>
                      <span class="downloads"><i class="fa fa-download"></i> <span class="js-downloads-{{ image.id }}">{{ image.numDownloads }}</span></span>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Featured Posts Section -->
  {% if featuredPosts and featuredPosts.length %}
  <div style="padding: 60px 0; background: #f9f9f9;">
    <div class="container">
      <h3 class="animate-on-scroll" style="text-align:center; margin-bottom:30px;"><i class="fa fa-star"></i> Posts Destacados</h3>
      <div class="row">
        {% for post in featuredPosts %}
        <div class="col-sm-4">
          <div class="post animate-on-scroll" style="margin-bottom:20px; transition-delay: {{ loop.index0 * 0.1 }}s;">
            <div class="post-heading">
              <img class="img-responsive" src="{{ asset('images/blog/' + post.image) }}" alt="{{ post.title }}">
            </div>
            <div class="post-body">
              <h4><a href="/single_post/{{ post.slug }}">{{ post.title }}</a></h4>
              <p>{{ post.content | truncate(120, false, '...') }}</p>
            </div>
            <div class="post-footer">
              <a class="btn btn-primary" href="/single_post/{{ post.slug }}">Leer más <i class="fa fa-arrow-right"></i></a>
              <span>
                <i class="fa fa-eye sr-icons"></i> {{ post.numViews }}
                <i class="fa fa-heart sr-icons"></i> {{ post.numLikes }}
              </span>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      <div style="text-align:center; margin-top:20px;">
        <a href="/blog" class="btn btn-lg sr-button">Ver todos los posts <i class="fa fa-arrow-right"></i></a>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- Newsletter Section -->
  <div class="newsletter-section animate-on-scroll" style="background: linear-gradient(rgba(108,99,255,0.9), rgba(80,70,220,0.9)), url('{{ asset('images/index/newsletter.jpg') }}') center/cover no-repeat;">
    <div class="container">
      <h3><i class="fa fa-envelope-o"></i> Suscríbete al Newsletter</h3>
      <p>Recibe las últimas novedades y fotografías directamente en tu correo</p>
      <form class="newsletter-form">
        <input type="email" placeholder="Tu correo electrónico" required>
        <button type="submit"><i class="fa fa-paper-plane"></i> Suscribirse</button>
      </form>
    </div>
  </div>

  <!-- Partners Section -->
  <div class="container">
    <div class="partners-section animate-on-scroll">
      <h4><i class="fa fa-handshake-o"></i> Nuestros Partners</h4>
      <div class="partners-grid">
        <div class="partner-item animate-on-scroll animate-scale" style="transition-delay: 0s;">
          <img src="{{ asset('images/index/log1.jpg') }}" alt="Partner 1">
          <span>Canon España</span>
        </div>
        <div class="partner-item">
          <img src="{{ asset('images/index/log2.jpg') }}" alt="Partner 2">
          <span>Nikon Pro</span>
        </div>
        <div class="partner-item">
          <img src="{{ asset('images/index/log3.jpg') }}" alt="Partner 3">
          <span>Sony Alpha</span>
        </div>
      </div>
    </div>
  </div>

</div><!-- End of index box -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function postJson(url) {
      return fetch(url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).then(function (response) { return response.json(); });
    }

    document.querySelectorAll('.js-image-view').forEach(function (link) {
      link.addEventListener('click', function () {
        var id = link.getAttribute('data-id');
        postJson('/images/' + id + '/view').then(function (data) {
          var counter = document.querySelector('.js-views-' + id);
          if (data.success && counter) {
            counter.textContent = data.views;
          }
        }).catch(function () {});
      });
    });

    document.querySelectorAll('.js-image-like').forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        var id = link.getAttribute('data-id');
        postJson('/images/' + id + '/like').then(function (data) {
          var counter = document.querySelector('.js-likes-' + id);
          if (data.success && counter) {
            counter.textContent = data.likes;
            link.style.opacity = data.liked ? '1' : '0.6';
          }
        }).catch(function () {});
      });
    });

    document.querySelectorAll('.js-image-download').forEach(function (link) {
      link.addEventListener('click', function () {
        var id = link.getAttribute('data-id');
        var counter = document.querySelector('.js-downloads-' + id);
        if (counter) {
          counter.textContent = Number(counter.textContent) + 1;
        }
      });
    });
  });
</script>
{% endblock %}
