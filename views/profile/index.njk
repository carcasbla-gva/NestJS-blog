{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Mi perfil | FotoBlog{% endblock %}
{% block body %}
<div id="register">
  <div class="container">
    <div class="col-xs-12 col-sm-8 col-sm-push-2">
      <h1>Mi perfil</h1>
      <hr class="divider">

      <h3>Avatar</h3>
      <div class="form-group">
        {% if avatar %}
          <img src="{{ asset('images/avatars/' + avatar) }}" alt="Avatar" style="width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:10px;">
        {% else %}
          <div style="width:120px;height:120px;border-radius:50%;background:#ddd;display:flex;align-items:center;justify-content:center;margin-bottom:10px;">
            <i class="fa fa-user" style="font-size:48px;color:#999;"></i>
          </div>
        {% endif %}
      </div>
      <form action="/profile/avatar" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="form-group">
          <label for="avatar">Cambiar foto de perfil</label>
          <input type="file" id="avatar" name="avatar" class="form-control" accept="image/jpeg,image/png">
          {{ forms.error(errors, 'avatar') }}
        </div>
        <button type="submit" class="btn btn-lg sr-button">Subir avatar</button>
      </form>

      <hr class="divider">

      <h3>Datos personales</h3>
      <form action="/profile" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" class="form-control" value="{{ values.name or '' }}">
          {{ forms.error(errors, 'name') }}
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" value="{{ values.email or '' }}">
          {{ forms.error(errors, 'email') }}
        </div>

        <div class="form-group">
          <label for="bio">Bio</label>
          <textarea id="bio" name="bio" class="form-control" rows="3">{{ values.bio or '' }}</textarea>
        </div>

        <button type="submit" class="btn btn-lg sr-button">Guardar cambios</button>
      </form>

      <hr class="divider">

      <h3>Cambiar contraseña</h3>
      <form action="/profile/password" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <label for="currentPassword">Contraseña actual</label>
          <input type="password" id="currentPassword" name="currentPassword" class="form-control" autocomplete="current-password">
          {{ forms.error(passwordErrors, 'currentPassword') }}
        </div>

        <div class="form-group">
          <label for="newPassword">Nueva contraseña</label>
          <input type="password" id="newPassword" name="newPassword" class="form-control" autocomplete="new-password">
          {{ forms.error(passwordErrors, 'newPassword') }}
        </div>

        <div class="form-group">
          <label for="confirmation">Repite la nueva contraseña</label>
          <input type="password" id="confirmation" name="confirmation" class="form-control" autocomplete="new-password">
          {{ forms.error(passwordErrors, 'confirmation') }}
        </div>

        <button type="submit" class="btn btn-lg sr-button">Cambiar contraseña</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
