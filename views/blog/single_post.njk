{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}{{ post.title }} | PhotographItem{% endblock %}
{% block description %}{{ post.content | truncate(160, true, '...') }}{% endblock %}
{% block canonical %}{{ siteUrl }}/single_post/{{ post.slug }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_title %}{{ post.title }}{% endblock %}
{% block og_description %}{{ post.content | truncate(160, true, '...') }}{% endblock %}
{% block head %}
  <meta property="og:image" content="{{ siteUrl }}{{ asset('images/blog/' + post.image) }}">
{% endblock %}

{% block body %}
<!-- Principal Content Start -->
<div id="single">
  <div class="container">
    <!-- Full Article -->
    <div class="row">
      <h2>{{ post.title }}</h2>
      <hr class="subtitle">
      <div class="block1">
        <div class="col-xs-12 col-sm-9">
          {% if post.category %}
            <p class="text-muted">
              <i class="fa fa-folder-open sr-icons"></i>
              <a href="/blog/categoria/{{ post.category.slug }}">{{ post.category.name }}</a>
              {% if not post.published %}<span class="label label-warning">Borrador</span>{% endif %}
            </p>
          {% endif %}

          <img class="img-responsive" src="{{ asset('images/blog/' + post.image) }}" alt="{{ post.title }}">
          <br>
          <p>{{ post.content }}</p>

          {% if post.tags and post.tags.length %}
            <p class="text-muted">
              {% for tag in post.tags %}
                <a href="/blog/buscar?searchTerm={{ tag | urlencode }}">#{{ tag }}</a>{% if not loop.last %} · {% endif %}
              {% endfor %}
            </p>
          {% endif %}

          <h4>- By {{ post.postUser.name if post.postUser else 'Anonymous' }}</h4>
          <hr>
          <ul class="list-inline">
            <li>{{ post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }} |</li>
            <li><i class="fa fa-eye sr-icons"></i> {{ post.numViews }} views |</li>
            <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{ post.numComments }} |</li>
            <li>
              <a id="like-button" href="/single_post/{{ post.slug }}/like" data-slug="{{ post.slug }}">
                {% if liked %}UNLIKE{% else %}LIKE{% endif %}
              </a>
              <i class="fa fa-heart sr-icons"></i><span id="likes"> {{ post.numLikes }}</span>
            </li>
            {% if currentUser and currentUser.isAdmin %}
              <li><a href="/admin/posts/{{ post.id }}/edit"><i class="fa fa-pencil sr-icons"></i> Editar</a></li>
            {% endif %}
          </ul>
        </div>
        <div class="col-xs-12 col-sm-3">
          <h4>Recent Post</h4>
          <hr class="subtitle1">
          {% for recent in recents %}
            {% include "../partials/recent_post.njk" %}
          {% endfor %}
        </div>
      </div>
    </div>
    <!-- End of Full Article -->

    <!-- Comments -->
    <div class="row">
      <div class="col-xs-12 col-sm-12 block2">
        {% for comment in comments %}
          <div class="comment">
            <h4>
              {{ comment.name }}
              {% if not comment.approved %}<span class="label label-warning">Pendiente de aprobación</span>{% endif %}
            </h4>
            <p class="time">{{ comment.publishedAt | date('g:i A') }} · {{ comment.publishedAt | date('d F Y') }}</p>
            <hr>
            <p>{{ comment.text }}</p>
          </div>
        {% else %}
          <p class="text-muted">Todavía no hay comentarios. ¡Sé el primero!</p>
        {% endfor %}

        <hr class="line">
        <div id="form" class="col-xs-12 col-sm-6 col-sm-push-3">
          <form action="/single_post/{{ post.slug }}/comment" method="post">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">

            <div style="display:none" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="form-group">
              <div class="col-xs-12 col-sm-6">
                <label for="commentName">Name</label>
                <input type="text" id="commentName" name="name" class="form-control" value="{{ commentValues.name or '' }}">
                {{ forms.error(commentErrors, 'name') }}
              </div>
              <div class="col-xs-12 col-sm-6">
                <label for="commentEmail">Email</label>
                <input type="email" id="commentEmail" name="email" class="form-control" value="{{ commentValues.email or '' }}">
                {{ forms.error(commentErrors, 'email') }}
              </div>
            </div>
            <div class="form-group">
              <div class="col-xs-12">
                <label for="commentText">Type Your Comment</label>
                <textarea id="commentText" name="text" class="form-control" rows="4">{{ commentValues.text or '' }}</textarea>
                {{ forms.error(commentErrors, 'text') }}
                <button type="submit" class="btn btn-lg btn-info sr-button">Send</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <!-- End of Comments -->
  </div>
</div>
<!-- End of Principal Content Start -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var likeLink = document.getElementById('like-button');
    var likesSpan = document.getElementById('likes');
    if (!likeLink) {
      return;
    }

    likeLink.addEventListener('click', function (event) {
      event.preventDefault();
      fetch(likeLink.getAttribute('href'), {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Content-Type': 'application/json'
        }
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (data.success) {
            likesSpan.innerHTML = ' ' + data.likes;
            likeLink.textContent = data.liked ? 'UNLIKE' : 'LIKE';
          }
        })
        .catch(function (error) { console.error('Error:', error); });
    });
  });
</script>
{% endblock %}
