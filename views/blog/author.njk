{% extends "../base.njk" %}
{% block title %}{{ author.name }} | FotoBlog{% endblock %}
{% block description %}Perfil del autor {{ author.name }}{% endblock %}

{% block body %}
<!-- Author Profile -->
<div id="blog">
  <div class="container">
    <div class="row">

      <!-- Author info & Posts -->
      <div class="col-xs-12 col-sm-8 row">
        <div class="col-xs-12">
          <div style="text-align:center;margin-bottom:30px;">
            {% if author.avatar %}
              <img src="{{ asset('images/avatars/' + author.avatar) }}" alt="{{ author.name }}" style="width:120px;height:120px;border-radius:50%;object-fit:cover;">
            {% else %}
              <img src="{{ asset('images/avatars/default-avatar.jpg') }}" alt="{{ author.name }}" style="width:120px;height:120px;border-radius:50%;object-fit:cover;">
            {% endif %}
            <h2>{{ author.name }}</h2>
            {% if author.bio %}
              <p class="text-muted">{{ author.bio }}</p>
            {% endif %}
            <p class="text-muted">{{ total }} post(s) publicado(s).</p>
          </div>
          <hr>
        </div>

        {% for post in posts %}
          {% include "../partials/post.njk" %}
        {% else %}
          <div class="col-xs-12">
            <p>{{ author.name }} aún no ha publicado ningún post.</p>
          </div>
        {% endfor %}

        {% include "../partials/pagination.njk" %}
      </div>
      <!-- End of Author Posts -->

      <!-- Side bar -->
      <div class="col-xs-12 col-sm-4">
        <div class="search-autocomplete-wrapper">
          <form action="/blog/buscar" method="get">
            <input type="text" id="searchAutocomplete" class="form-control" style="display:unset; width:85%" placeholder="Buscar..." name="searchTerm">
            <button type="submit" class="btn btn-primary btn-danger"><i class="fa fa-search"></i></button>
          </form>
          <div id="searchAutocompleteResults" class="search-autocomplete-results"></div>
        </div>
        <div class="panel">
          <div class="panel-heading">
            <h4>Categorías</h4>
          </div>
          <div class="panel-body">
            <ul class="nav">
              {% for item in categories %}
                <li class="{% if loop.last %}last{% endif %}">
                  <a href="/blog/categoria/{{ item.slug }}">
                    {{ item.name }} <span class="text-muted">({{ item.postCount or 0 }})</span>
                  </a>
                </li>
              {% else %}
                <li><span class="text-muted">Sin categorías</span></li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <h3>Posts recientes</h3>
        <hr>
        {% for recent in recents %}
          {% include "../partials/recent_post.njk" %}
        {% endfor %}
      </div>
      <!-- End of Side bar -->
    </div>
  </div>
</div>
{% endblock %}
