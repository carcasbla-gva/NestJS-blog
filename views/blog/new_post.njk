{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Nuevo post | FotoBlog{% endblock %}
{% block head %}
  <link rel="stylesheet" href="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.css" referrerpolicy="origin">
{% endblock %}
{% block body %}
<!-- Principal Content Start -->
<div id="new-post">
  <div class="container">
    <div class="col-xs-12 col-sm-8 col-sm-push-2">
      <h1>Nuevo post</h1>
      <hr class="divider">

      <form class="form-horizontal" action="/blog/new" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <div class="col-xs-12">
            <label for="title">Título</label>
            <input type="text" id="title" name="title" class="form-control" value="{{ values.title or '' }}">
            {{ forms.error(errors, 'title') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="content">Contenido</label>
            <textarea id="content" name="content" class="form-control" rows="8">{{ values.content or '' }}</textarea>
            {{ forms.error(errors, 'content') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12 col-sm-6">
            <label for="category">Categoría</label>
            <select id="category" name="category" class="form-control">
              <option value="">-- Sin categoría --</option>
              {% for category in categories %}
                <option value="{{ category.id }}" {% if (category.id | string) == ((values.category or '') | string) %}selected{% endif %}>{{ category.name }}</option>
              {% endfor %}
            </select>
            {{ forms.error(errors, 'category') }}
          </div>
          <div class="col-xs-12 col-sm-6">
            <label for="tags">Etiquetas</label>
            <input type="text" id="tags" name="tags" class="form-control" placeholder="fotografía, viajes, luz" value="{{ values.tags or '' }}">
            <span class="help-block">Separa las etiquetas con comas.</span>
            {{ forms.error(errors, 'tags') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="image">Imagen</label>
            <input type="file" id="image" name="image" class="form-control" accept="image/jpeg,image/png">
            {{ forms.error(errors, 'image') }}
          </div>
        </div>

        {% if currentUser and currentUser.isAdmin %}
          <div class="checkbox">
            <label>
              <input type="checkbox" name="published" value="1" {% if values.published != '' %}checked{% endif %}>
              Publicar inmediatamente (si lo desmarcas se guarda como borrador)
            </label>
          </div>
        {% endif %}

        <div class="form-group">
          <div class="col-xs-12">
            <button type="submit" class="pull-right btn btn-lg sr-button">Enviar</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<!-- Principal Content Start -->
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
tinymce.init({
  selector: '#content',
  height: 400,
  plugins: 'lists link image code table',
  toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
  menubar: false,
  statusbar: false,
  content_style: 'body { font-family: Inter, sans-serif; font-size: 14px; }'
});
</script>
{% endblock %}
