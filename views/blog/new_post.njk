{% extends "../base.njk" %}
{% import "../macros/forms.njk" as forms %}
{% block title %}Nuevo post | PhotographItem{% endblock %}
{% block body %}
<!-- Principal Content Start -->
<div id="new-post">
  <div class="container">
    <div class="col-xs-12 col-sm-8 col-sm-push-2">
      <h1>New Post</h1>
      <hr class="divider">

      <form class="form-horizontal" action="/blog/new" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <div class="form-group">
          <div class="col-xs-12">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" class="form-control" value="{{ values.title or '' }}">
            {{ forms.error(errors, 'title') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="content">Content</label>
            <textarea id="content" name="content" class="form-control" rows="8">{{ values.content or '' }}</textarea>
            {{ forms.error(errors, 'content') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12 col-sm-6">
            <label for="category">Category</label>
            <select id="category" name="category" class="form-control">
              <option value="">-- Sin categoría --</option>
              {% for category in categories %}
                <option value="{{ category.id }}" {% if (category.id | string) == ((values.category or '') | string) %}selected{% endif %}>{{ category.name }}</option>
              {% endfor %}
            </select>
            {{ forms.error(errors, 'category') }}
          </div>
          <div class="col-xs-12 col-sm-6">
            <label for="tags">Tags</label>
            <input type="text" id="tags" name="tags" class="form-control" placeholder="fotografía, viajes, luz" value="{{ values.tags or '' }}">
            <span class="help-block">Separa las etiquetas con comas.</span>
            {{ forms.error(errors, 'tags') }}
          </div>
        </div>

        <div class="form-group">
          <div class="col-xs-12">
            <label for="image">Image</label>
            <input type="file" id="image" name="image" class="form-control" accept="image/jpeg,image/png">
            {{ forms.error(errors, 'image') }}
          </div>
        </div>

        {% if currentUser and currentUser.isAdmin %}
          <div class="checkbox">
            <label>
              <input type="checkbox" name="published" value="1" {% if values.published != '' %}checked{% endif %}>
              Publicar inmediatamente (si lo desmarcas se guarda como borrador)
            </label>
          </div>
        {% endif %}

        <div class="form-group">
          <div class="col-xs-12">
            <button type="submit" class="pull-right btn btn-lg sr-button">Send</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<!-- Principal Content Start -->
{% endblock %}
