<div class="col-xs-12 col-sm-6 col-md-3">
  <div class="sol">
    <img class="img-responsive" src="{{ asset('images/index/gallery/' + (image.thumbnail or image.file)) }}" alt="{{ image.category.name if image.category else 'Category picture' }}">
    <div class="behind">
      <div class="head text-center">
        <ul class="list-inline">
          <li>
            <a class="gallery js-image-view" href="{{ asset('images/index/gallery/' + image.file) }}" data-id="{{ image.id }}" data-toggle="tooltip" data-original-title="Quick View">
              <i class="fa fa-eye"></i>
            </a>
          </li>
          <li>
            <a href="/images/{{ image.id }}/like" class="js-image-like" data-id="{{ image.id }}" data-toggle="tooltip" data-original-title="Click if you like it">
              <i class="fa fa-heart"></i>
            </a>
          </li>
          <li>
            <a href="/images/{{ image.id }}/download" class="js-image-download" data-id="{{ image.id }}" data-toggle="tooltip" data-original-title="Download">
              <i class="fa fa-download"></i>
            </a>
          </li>
          <li>
            <a href="/blog/categoria/{{ image.category.slug if image.category else '' }}" data-toggle="tooltip" data-original-title="More information">
              <i class="fa fa-info"></i>
            </a>
          </li>
        </ul>
      </div>
      <div class="row box-content">
        <ul class="list-inline text-center">
          <li><i class="fa fa-eye"></i> <span class="js-views-{{ image.id }}">{{ image.numViews }}</span></li>
          <li><i class="fa fa-heart"></i> <span class="js-likes-{{ image.id }}">{{ image.numLikes }}</span></li>
          <li><i class="fa fa-download"></i> <span class="js-downloads-{{ image.id }}">{{ image.numDownloads }}</span></li>
        </ul>
      </div>
    </div>
  </div>
</div>
