<div class="col-xs-12 col-sm-12">
  <div class="post">
    <div class="post-heading">
      <span>{{ post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }}</span>
      <img class="img-responsive" src="{{ asset('images/blog/' + post.image) }}" alt="{{ post.title }}">
    </div>
    <div class="post-body">
      {% if post.category %}
        <p class="text-muted">
          <i class="fa fa-folder-open sr-icons"></i>
          <a href="/blog/categoria/{{ post.category.slug }}">{{ post.category.name }}</a>
        </p>
      {% endif %}
      <h3><a href="/single_post/{{ post.slug }}"><strong>{{ post.title }}</strong></a></h3>
      <hr>
      <p>{{ post.content | truncate(300, false, '...') }}</p>
      {% if post.tags and post.tags.length %}
        <p class="text-muted">
          {% for tag in post.tags %}
            <a href="/blog/buscar?searchTerm={{ tag | urlencode }}">#{{ tag }}</a>{% if not loop.last %} · {% endif %}
          {% endfor %}
        </p>
      {% endif %}
    </div>
    <div class="post-footer">
      <a class="btn" href="/single_post/{{ post.slug }}">READ MORE...</a>
      <span>
        <i class="fa fa-eye sr-icons"></i> {{ post.numViews }}
        <i class="fa fa-heart sr-icons"></i> {{ post.numLikes }}
        <i class="fa fa-comments sr-icons"></i> {{ post.numComments }}
      </span>
    </div>
  </div>
</div>
