{% extends "../base.njk" %}
{% block title %}Administración - FotoBlog{% endblock %}
{% block body %}
<div class="admin-page">
  <div class="container">
    <div class="admin-header">
      <h1><i class="fa fa-cog text-primary"></i> Panel de Administración</h1>
      <p>Gestiona el contenido de tu blog de fotografía</p>
    </div>

    {% include "admin/nav.njk" %}

    <!-- Stats -->
    <div class="admin-stats">
      <div class="admin-stat-card">
        <i class="fa fa-file-text-o"></i>
        <h3>{{ stats.posts }}</h3>
        <p>Publicaciones</p>
        {% if stats.drafts %}<small style="color: var(--secondary);">{{ stats.drafts }} borrador(es)</small>{% endif %}
      </div>
      <div class="admin-stat-card">
        <i class="fa fa-comments"></i>
        <h3>{{ stats.comments }}</h3>
        <p>Comentarios</p>
        {% if stats.pendingComments %}<small style="color: var(--secondary);">{{ stats.pendingComments }} pendiente(s)</small>{% endif %}
      </div>
      <div class="admin-stat-card">
        <i class="fa fa-image"></i>
        <h3>{{ stats.images }}</h3>
        <p>Imágenes</p>
      </div>
      <div class="admin-stat-card">
        <i class="fa fa-envelope-o"></i>
        <h3>{{ stats.messages }}</h3>
        <p>Mensajes</p>
      </div>
      <div class="admin-stat-card">
        <i class="fa fa-tags"></i>
        <h3>{{ stats.categories }}</h3>
        <p>Categorías</p>
      </div>
      <div class="admin-stat-card">
        <i class="fa fa-users"></i>
        <h3>{{ stats.users }}</h3>
        <p>Usuarios</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="admin-card">
      <h3><i class="fa fa-bolt text-primary"></i> Acciones rápidas</h3>
      <div style="display: flex; gap: 15px; flex-wrap: wrap;">
        <a href="/blog/new" class="btn btn-primary"><i class="fa fa-plus"></i> Nuevo post</a>
        <a href="/admin/images" class="btn btn-primary"><i class="fa fa-upload"></i> Subir imagen</a>
        <a href="/admin/categories" class="btn btn-primary"><i class="fa fa-tags"></i> Gestionar categorías</a>
        <a href="/admin/comments" class="btn btn-primary"><i class="fa fa-comments"></i> Moderar comentarios</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
