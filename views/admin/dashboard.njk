{% extends "../base.njk" %}
{% block title %}Admin | PhotographItem{% endblock %}
{% block body %}
<div id="categories">
  <div class="container">
    <h1>Panel de administración</h1>
    <hr class="divider">

    {% include "admin/nav.njk" %}

    <div class="row text-center">
      <div class="col-xs-6 col-sm-3">
        <div class="well">
          <h2>{{ stats.posts }}</h2>
          <p class="text-muted">Posts</p>
          {% if stats.drafts %}<p class="text-warning">{{ stats.drafts }} borrador(es)</p>{% endif %}
        </div>
      </div>
      <div class="col-xs-6 col-sm-3">
        <div class="well">
          <h2>{{ stats.comments }}</h2>
          <p class="text-muted">Comentarios</p>
          {% if stats.pendingComments %}<p class="text-warning">{{ stats.pendingComments }} pendiente(s)</p>{% endif %}
        </div>
      </div>
      <div class="col-xs-6 col-sm-3">
        <div class="well">
          <h2>{{ stats.images }}</h2>
          <p class="text-muted">Imágenes</p>
        </div>
      </div>
      <div class="col-xs-6 col-sm-3">
        <div class="well">
          <h2>{{ stats.messages }}</h2>
          <p class="text-muted">Mensajes</p>
        </div>
      </div>
    </div>

    <div class="row text-center">
      <div class="col-xs-6 col-sm-4">
        <div class="well">
          <h3>{{ stats.categories }}</h3>
          <p class="text-muted">Categorías</p>
        </div>
      </div>
      <div class="col-xs-6 col-sm-4">
        <div class="well">
          <h3>{{ stats.users }}</h3>
          <p class="text-muted">Usuarios</p>
        </div>
      </div>
      <div class="col-xs-12 col-sm-4">
        <div class="well">
          <h3>Acciones rápidas</h3>
          <p>
            <a href="/blog/new" class="btn btn-sm sr-button">Nuevo post</a>
            <a href="/admin/images" class="btn btn-sm sr-button">Subir imagen</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
