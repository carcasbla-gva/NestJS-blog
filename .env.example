PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=sa
DB_DATABASE=nestjs_blog
# Crea la base de datos al arrancar si no existe (desactivado en producción
# salvo que se ponga a true).
DB_AUTO_CREATE=true

SESSION_SECRET=cambia-esta-clave-en-produccion
SEED_DB=true

# Correo (verificación de cuenta y recuperación de contraseña).
# Si MAIL_HOST está vacío, los correos se escriben en el log.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=NestJS Blog <no-reply@blog.local>
